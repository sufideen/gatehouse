DATABASE_URL=postgres://gatehouse:gatehouse@localhost:5432/gatehouse
REDIS_URL=redis://localhost:6379
API_PORT=4000
S3_BUCKET=gatehouse-media-eu-west-2
AWS_REGION=eu-west-2

# --- web app (apps/web) ---
AUTH_SECRET=change-me-to-32-or-more-random-characters
# Web port: PORT=3100 by default (set PORT to change). Keep APP_BASE_URL in sync.
APP_BASE_URL=http://localhost:3100
# Real pilot data only on the dedicated pilot deployment:
# ALLOW_PILOT_DATA=true
# Email (password reset). Any SMTP provider; for AWS SES use the eu-west-2 SMTP endpoint and a verified domain (SPF/DKIM/DMARC):
# SMTP_URL=smtps://SMTP_USER:SMTP_PASS@email-smtp.eu-west-2.amazonaws.com:465
# MAIL_FROM="Gatehouse <no-reply@yourdomain.co.uk>"
# --- mobile (apps/mobile) ---
# EXPO_PUBLIC_API_URL=https://your-deployment.example

# --- docker-compose.prod.yml (see deploy/DEPLOY.md) ---
# DOMAIN=gatehouse.yourcompany.co.uk
# DB_PASSWORD=generate-with-openssl-rand-hex-24
